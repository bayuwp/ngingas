// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Materi {
  id        Int      @id @default(autoincrement())
  judul     String
  deskripsi String
  linkVideo String?
  namaModul String    // Properti ini tidak boleh null
  namaPpt   String?
  namaTugas String?
  gambar    String?
  createdAt DateTime @default(now())
}

model Produk {
  id          Int        @id @default(autoincrement())
  namaProduk  String     @db.VarChar(255)
  kategori    String     @db.VarChar(255)
  deskripsi   String     @db.Text
  harga       Float      @default(0)
  foto        String?    @db.VarChar(255) // URL atau path file foto
  video       String?    @db.VarChar(255) // URL atau path file video
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relasi balik ke tabel Keranjang
  keranjang   Keranjang[]
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  role      String    @default("user") // Role untuk membedakan user/admin
  createdAt DateTime  @default(now())

  profile   Profile?
}

model Profile {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  foto      String?   // URL foto profil
  kelas     String
  jurusan   String
  alamat   String?
  createdAt DateTime  @default(now())

  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id])
}

model Keranjang {
  id          Int      @id @default(autoincrement())
  produkId    Int
  qty         Int
  subtotal    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi ke tabel Produk
  produk      Produk   @relation(fields: [produkId], references: [id])
}
